#--------------------------------------------------------------------
# CI_EMPLOYER - Arquivo de exemplo de configuracao
#--------------------------------------------------------------------
# Copie este arquivo para `.env` e ajuste os valores.
# O arquivo `.env` NUNCA deve ser versionado.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# AMBIENTE
#--------------------------------------------------------------------
# development | testing | production
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APLICACAO
#--------------------------------------------------------------------
# URL base usada em canonical, Open Graph e links absolutos.
app.baseURL = 'http://localhost:8080/'

#--------------------------------------------------------------------
# BANCO DE DADOS (MySQL / MariaDB)
#--------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = ci_employer
database.default.username = ci_employer
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# CRIPTOGRAFIA DA APP PASSWORD DOS USUARIOS
#--------------------------------------------------------------------
# Chave mestra usada por App\Libraries\Criptografia (AES-256-CBC).
# Gere uma chave aleatoria de 32 bytes em Base64, por exemplo:
#   php -r "echo base64_encode(random_bytes(32));"
# NUNCA troque esta chave depois que houver dados criptografados:
# os APP PASSWORDS salvos se tornariam ilegiveis.
CRIPTOGRAFIA_CHAVE =

#--------------------------------------------------------------------
# SMTP (Gmail)
#--------------------------------------------------------------------
# ATENCAO: NAO existe conta SMTP global no sistema.
# Cada usuario configura o proprio e-mail e APP PASSWORD no painel.
# Estes valores abaixo sao apenas os parametros TECNICOS do servidor
# Gmail usados pela biblioteca EnviadorEmail ao enviar em nome do
# usuario autenticado.
email.SMTPHost = smtp.gmail.com
email.SMTPPort = 587
email.SMTPCrypto = tls
email.SMTPTimeout = 30

#--------------------------------------------------------------------
# UPLOADS
#--------------------------------------------------------------------
# Caminho absoluto da pasta de uploads (fora do diretorio publico).
uploads.caminho = WRITEPATH/uploads

#--------------------------------------------------------------------
# CRON
#--------------------------------------------------------------------
# Quantidade maxima de consultas ao provedor de vagas por execucao
# do CRON 1 (busca de vagas). Evita esgotar a cota de uma vez.
cron.limiteConsultasPorExecucao = 40

# Quantidade maxima de consultas por usuario em uma execucao (0 = sem limite).
cron.limiteConsultasPorUsuario = 0

# Pausa, em segundos, entre duas consultas ao provedor externo.
cron.pausaEntreConsultas = 1

# Quantidade maxima de usuarios processados por execucao (0 = todos).
cron.limiteUsuariosPorExecucao = 0

# Quantidade maxima de e-mails enviados por execucao do CRON 2
# (envio automatico). Cada usuario envia no maximo um e-mail por
# execucao e respeita o intervalo configurado no painel.
cron.envioAutomaticoLimitePorExecucao = 50

#--------------------------------------------------------------------
# PROVEDOR DE VAGAS
#--------------------------------------------------------------------
# Servico usado na busca de vagas:
#   serpapi -> provedor real (Google Jobs via SerpApi)  [padrao]
#   falso   -> provedor de desenvolvimento, SEM internet.
#              Devolve vagas ficticias e serve para testar todo o
#              fluxo (cota, rotacao de chave, deduplicacao, logs)
#              sem precisar de uma chave real. NUNCA usar em producao.
provedorVagas.servico = serpapi

# Endpoint do SerpApi.
provedorVagas.urlBase = https://serpapi.com/search.json

# Tempo maximo de cada requisicao, em segundos, e tentativas em caso de falha.
provedorVagas.tempoLimite = 30
provedorVagas.tentativas = 2

# Numero de paginas pedidas por combinacao (termo + cidade).
# Cada pagina e uma consulta cobrada pelo provedor.
provedorVagas.paginasPorConsulta = 1

#--------------------------------------------------------------------
# SESSAO
#--------------------------------------------------------------------
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.savePath = null

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------
logger.threshold = 4
